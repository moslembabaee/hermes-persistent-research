# PGRA ships with no credentials and requires none at install time.
# Configure a provider through your own local Hermes setup. Never commit .env.

# Examples only; use names supported by your installed Hermes version:
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional research/search/browser providers, configured locally if desired:
TAVILY_API_KEY=
EXA_API_KEY=
BROWSERBASE_API_KEY=
